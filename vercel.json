{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(assets|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=30, stale-while-revalidate=60"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "site/data/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sucesos",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.andentren.es"
        }
      ],
      "destination": "https://andentren.es/$1",
      "permanent": true
    },
    {
      "source": "/trenes",
      "destination": "/mapa-trenes",
      "permanent": true
    }
  ]
}
